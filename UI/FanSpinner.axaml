<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AcerHelper.UI.FanSpinner"
             Width="24" Height="24">

  <!-- A shrouded fan: the housing rings stay still, the rotor turns inside them, and the hub is a machined cap
       on top. The BLADES are generated in code (FanSpinner.axaml.cs) because their shape is parametric - a
       count, a sweep and a taper - and because each blade is its own path, so a blade can carry its own shade.
       Only the spin speed comes from code at runtime; the shroud and the hub are declarative here. -->
  <Grid>
    <Ellipse x:Name="Shroud" StrokeThickness="1.2"/>
    <Ellipse x:Name="ShroudInner" Margin="1.6" StrokeThickness="0.6"/>
    <Canvas x:Name="Rotor" RenderTransformOrigin="50%,50%">
      <Canvas.RenderTransform>
        <RotateTransform/>
      </Canvas.RenderTransform>
    </Canvas>
    <Ellipse x:Name="Hub" Width="6.6" Height="6.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Ellipse x:Name="HubRing" Width="4.6" Height="4.6" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="0.7"/>
    <Ellipse x:Name="HubCore" Width="1.4" Height="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Ellipse x:Name="HubShine" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1.6,-1.6,0,0"/>
  </Grid>
</UserControl>
