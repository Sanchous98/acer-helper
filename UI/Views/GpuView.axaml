<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AcerHelper.UI.ViewModels"
             xmlns:l="clr-namespace:AcerHelper.Localization"
             x:Class="AcerHelper.UI.Views.GpuView"
             x:DataType="vm:GpuViewModel">

  <!-- Bare drawer content; the side drawer supplies the surrounding panel and the "GPU" title. -->
  <StackPanel Spacing="8">

    <!-- Which GPU is being tuned (driver-reported name) + a Reset-to-stock button. Name trimmed so a long
         name can't widen the fixed flyout. -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding GpuName}" Text="{Binding GpuName}"/>
      <Button Grid.Column="1" Content="{l:Tr 'oc.reset'}" Padding="10,4" Command="{Binding ResetCommand}"/>
    </Grid>

    <!-- Core clock offset (MHz). -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Classes="muted" Width="64" VerticalAlignment="Center" Text="{l:Tr 'oc.gpu_core'}"/>
      <Slider Grid.Column="1" Minimum="{Binding CoreMin}" Maximum="{Binding CoreMax}" TickFrequency="25"
              VerticalAlignment="Center" Value="{Binding Core, Mode=TwoWay}"/>
      <TextBlock Grid.Column="2" Width="72" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                 Text="{Binding CoreLabel}"/>
    </Grid>

    <!-- Memory clock offset (MHz). Raw memory-clock offset (G-Helper convention), not the doubled
         "effective" figure Afterburner shows. -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Classes="muted" Width="64" VerticalAlignment="Center" Text="{l:Tr 'oc.gpu_memory'}"/>
      <Slider Grid.Column="1" Minimum="{Binding MemMin}" Maximum="{Binding MemMax}" TickFrequency="50"
              VerticalAlignment="Center" Value="{Binding Mem, Mode=TwoWay}"/>
      <TextBlock Grid.Column="2" Width="72" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                 Text="{Binding MemLabel}"/>
    </Grid>

    <!-- GPU power level: which of the EC's fixed envelope rows the dGPU runs at, remembered per mode. Only
         shown where the machine exposes the EC envelope channel (HasPower); its rows are the EC's own four
         distinct measured levels (the Eco row enforces the same envelope as Quiet and is not offered) —
         there is no arbitrary wattage on this platform (docs/power-an18-61.md). The default
         row, index 0, is "follow the profile": the envelope then moves with the performance mode exactly as
         before. Row names carry the measured steady watts so the trade-off is visible.
         Laid out like the CPU power-mode row and the Options choice rows (label fills the left, a
         content-sized dropdown sits on the right) so every "label + selector" row in the app reads the same and
         the select is not stretched across the card. -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPower}">
      <TextBlock Classes="muted" VerticalAlignment="Center" Margin="0,0,10,0" Text="{l:Tr 'oc.gpu_power'}"/>
      <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                ItemsSource="{Binding PowerNames}"
                SelectedIndex="{Binding PowerIndex, Mode=TwoWay}"/>
    </Grid>

  </StackPanel>
</UserControl>
