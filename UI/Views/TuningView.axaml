<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AcerHelper.UI.ViewModels"
             xmlns:l="clr-namespace:AcerHelper.Localization"
             x:Class="AcerHelper.UI.Views.TuningView"
             x:DataType="vm:TuningViewModel">

  <!-- The Tuning drawer body: each present child (GPU clock offsets / CPU power mode) in its own acrylic card
       with a section header — the SAME frosted, borderless card as the main-page sections (Monitor/Fans/…).
       The child views (GpuView/CpuView) are bare and rendered via their DataTemplates. Cards carry their own
       bottom margin (see the .card style), so no outer spacing. -->
  <StackPanel>

    <ExperimentalAcrylicBorder Classes="card" Material="{DynamicResource CardMaterial}" IsVisible="{Binding HasGpu}">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="{l:Tr GPU}"/>
        <ContentControl Content="{Binding Gpu}"/>
      </StackPanel>
    </ExperimentalAcrylicBorder>

    <!-- GPU mode (MUX): the shared IGpuMux card. It shows ONE stable line — the mode the firmware is in NOW —
         and, while the value that will apply after a reboot differs from the ORIGINAL value the card first
         showed, marks that value with a trailing '*' and shows a short muted note NEXT TO THE SELECTOR. There is
         NO Apply button: choosing a different mode in the ComboBox runs the change flow (confirm, then queue;
         cancel/revert snaps the selection back), so the selector IS the switch. There is no inline suffix, no
         second line and no always-present caption: the note is conditional (GpuMux.NoteVisible) and shares the
         selector's row, so it neither reserves a blank nor adds a full-width caption. The line is explicitly
         NoWrap with compact labels, so the mark can never wrap to a second row. The no-MUX refusal is prose and
         may still wrap (Supported never changes at runtime, so exactly one of the two state TextBlocks is ever
         visible). Rendered inline (not a separate view) because it has no children. -->
    <ExperimentalAcrylicBorder Classes="card" Material="{DynamicResource CardMaterial}" IsVisible="{Binding HasGpuMux}">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="{l:Tr GPU mode}"/>
        <TextBlock x:Name="GpuMuxState" Text="{Binding GpuMux.CurrentText}" TextWrapping="NoWrap"
                   IsVisible="{Binding GpuMux.Supported}"/>
        <TextBlock x:Name="GpuMuxUnsupported" Text="{Binding GpuMux.CurrentText}" TextWrapping="Wrap"
                   IsVisible="{Binding !GpuMux.Supported}"/>
        <!-- The selector IS the switch (no Apply button): a selection change runs the ViewModel's confirm/queue
             flow, and cancelling snaps the selection back. The conditional note sits immediately next to the
             selector, so it never reserves an always-present blank. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <ComboBox Grid.Column="0" MinWidth="160" HorizontalAlignment="Left"
                    ItemsSource="{Binding GpuMux.Modes}"
                    SelectedIndex="{Binding GpuMux.SelectedIndex, Mode=TwoWay}"
                    IsEnabled="{Binding GpuMux.Supported}"/>
          <TextBlock x:Name="GpuMuxNote" Grid.Column="1" Classes="muted" FontSize="11"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     IsVisible="{Binding GpuMux.NoteVisible}" Text="{Binding GpuMux.Note}"/>
        </Grid>
      </StackPanel>
    </ExperimentalAcrylicBorder>

    <!-- One "CPU" card for both CPU axes: the OS power-mode picker and the undervolt slider are independent
         capabilities (either can be absent) but they are the same subject, so they share a header instead of
         producing two cards both titled "CPU". -->
    <ExperimentalAcrylicBorder Classes="card" Material="{DynamicResource CardMaterial}" IsVisible="{Binding HasCpuCard}">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="{l:Tr CPU}"/>
        <ContentControl Content="{Binding Cpu}" IsVisible="{Binding HasCpu}"/>
        <ContentControl Content="{Binding Co}" IsVisible="{Binding HasCo}"/>
      </StackPanel>
    </ExperimentalAcrylicBorder>

  </StackPanel>
</UserControl>
