<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AcerHelper.UI.ViewModels"
        xmlns:l="clr-namespace:AcerHelper.Localization"
        x:Class="AcerHelper.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Acer Nitro" Width="468" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" WindowDecorations="None" 
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent" TransparencyLevelHint="AcrylicBlur,Transparent">

  <!-- Single flyout window with an in-window navigation stack (like a mobile app): one fixed-size
       "phone frame" (never resizes at runtime => no X11 resize jitter), a static acrylic-tint card as
       the background, and Home / Options / Lighting as pages that push over each other INSIDE it. The
       drawer used to be a second window (parked behind the main one); now it's just VM state
       (IsDrawerOpen) driving a content-level slide — the WM never sees a second map/unmap, and the
       acrylic backdrop stays put while pages navigate on top of it. -->
  <Window.Styles>
    <!-- Push navigation: Home slides fully out to the left as the drawer page slides in from the right.
         Both pages fill the card and translate by its width (468), so at every moment the visible area
         shows exactly one page (no overlap => the shared acrylic reads continuously behind them). Driven
         by the .pushed / .open classes bound to IsDrawerOpen; the Transitions animate the swap. -->
    <Style Selector="Grid#HomePage">
      <Setter Property="RenderTransform" Value="translateX(0)"/>
    </Style>
    <Style Selector="Grid#HomePage.pushed">
      <Setter Property="RenderTransform" Value="translateX(-468px)"/>
    </Style>
    <Style Selector="Grid#DrawerPage">
      <Setter Property="RenderTransform" Value="translateX(468px)"/>
    </Style>
    <Style Selector="Grid#DrawerPage.open">
      <Setter Property="RenderTransform" Value="translateX(0)"/>
    </Style>
  </Window.Styles>

  <!-- Backdrop fills the whole window incl. the 20px transparent shadow margin around the card. A click
       on it (Source == Backdrop, i.e. the margin, not the card) is a click "outside" => dismiss. -->
  <Panel x:Name="Backdrop" Background="Transparent">
  <Border x:Name="Root" Width="468"
          Background="{DynamicResource AppAcrylicTint}"
          CornerRadius="{DynamicResource OverlayCornerRadius}"
          ClipToBounds="True"
          BoxShadow="0 4 16 0 #55000000">
    <!-- No open/close reveal on the window itself (it shows/hides instantly); only the in-window page-push
         transitions below (Home <-> drawer) animate. -->

    <Panel>

      <!-- ===== Home page ===== -->
      <Grid x:Name="HomePage" Classes.pushed="{Binding IsDrawerOpen}">
        <Grid.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseInOut"/>
          </Transitions>
        </Grid.Transitions>
        <DockPanel Margin="14">

          <!-- Header: device name + tiny version tag + current-profile accent chip + the notification bell.
               The messages this app has for the user used to sit ABOVE this row as full-width banners (an
               available update, a missing permission). They are behind the bell now: a banner is on screen
               whether or not it is news, and one that is always there stops being read — while the count on
               the bell is what makes hiding them safe. See MainViewModel.Notifications. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,2,2,12">
            <!-- DockPanel, NOT a horizontal StackPanel: a StackPanel measures children unconstrained, so a
                 long device name (raw DMI string on the Dell/generic backends, user-overridable JSON on
                 Acer) would push the version tag under the translucent chip / off the card. Here the tag
                 is measured first (Dock=Right) and the name fills the rest and ellipsizes; Left alignment
                 keeps the tag adjacent to short names instead of parked at the column edge. -->
            <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
              <!-- Unobtrusive version indicator: extra-muted, sized to read as a tag, nudged down toward
                   the h1 baseline (11px on a 16px neighbour centres visually too high otherwise). The
                   tooltip names the app: next to a hardware name an unlabeled "v0.20.2" would read as a
                   device/BIOS version. -->
              <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Opacity="0.75"
                         VerticalAlignment="Center" Margin="7,2,0,0" Text="{Binding AppVersion}"
                         ToolTip.Tip="{Binding AppVersionTip}"/>
              <TextBlock Classes="h1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding DeviceName}"/>
            </DockPanel>
            <Border Grid.Column="1" Classes="chip" IsVisible="{Binding HasProfile}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" Text="{Binding ProfileName}"/>
              </StackPanel>
            </Border>
            <!-- The bell. The badge is the point of it: the messages are hidden, so the COUNT of what has not
                 been read has to be on screen instead — a bell with no badge is a place notifications go to be
                 missed. A click toggles the list below (same control opens and closes it, like the drawer
                 buttons). The glyph is drawn, not an icon font, like the drawer's back arrow. -->
            <Button Grid.Column="2" Classes="icon" Margin="4,0,0,0"
                    Command="{Binding ToggleNotificationsCommand}">
              <Panel Width="20" Height="20">
                <!-- Centred in its box: the glyph was drawn bottom-left to keep the badge's corner clear, which
                     reads as an off-centre bell. The badge overhangs the corner instead (below). -->
                <Path Width="16" Height="16" Stretch="None"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M4.2,10.8 V6.4 C4.2,4.3 5.9,2.6 8,2.6 C10.1,2.6 11.8,4.3 11.8,6.4 V10.8
                            M2.6,10.8 H13.4
                            M6.5,13 C6.8,13.8 7.3,14.2 8,14.2 C8.7,14.2 9.2,13.8 9.5,13"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                        MinWidth="14" Height="14" CornerRadius="7" Padding="4,0"
                        Background="{DynamicResource AccentBrush}"
                        IsVisible="{Binding Notifications.HasUnread}">
                  <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="{Binding Notifications.UnreadBadge}"/>
                </Border>
              </Panel>
            </Button>
          </Grid>

          <!-- Footer: status text + drawer launch buttons -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2,12,2,0">
            <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Status}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="{l:Tr Options}" Padding="14,5"
                      IsVisible="{Binding ShowOptions}" Command="{Binding OpenOptionsCommand}"/>
              <Button Content="{l:Tr Tuning}" Padding="14,5"
                      IsVisible="{Binding ShowTuning}" Command="{Binding OpenTuningCommand}"/>
              <Button Classes="accent" Content="{l:Tr Lighting}" Padding="14,5"
                      IsVisible="{Binding ShowLighting}" Command="{Binding OpenLightingCommand}"/>
            </StackPanel>
          </Grid>

          <!-- Body: capability sections, single full-width column, scrolls within the fixed frame. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}"/>
          </ScrollViewer>

        </DockPanel>

        <!-- ===== The bell's list (the notification drop-down) =====
             IN THE WINDOW, and not a popup window of its own like a ComboBox's drop-down. Three reasons, all of
             them about what this app has measured rather than about taste:
               * a popup is a separate top-level window, and this window HIDES ITSELF when it loses activation
                 (FlyoutCoordinator.MaybeDismiss) — a drop-down that deactivated its owner would take the whole
                 panel with it, which is a coupling nothing in this suite can see;
               * the card is SizeToContent, and the anchor is re-read on every size change for exactly that
                 reason, so a drop-down is not the place to discover a second source of resizes;
               * the session's popup placement is the one thing that is NOT simply the toolkit's (see
                 docs/ui-popup-placement.md), and an in-window panel has no placement to get wrong.
             Anchored under the bell (the header row's height plus its own top margin), so it reads as that
             button's drop-down. A plain overlay: the entries live in the view model, and nothing here is
             conditional except its visibility.

             OUTSIDE-CLICK DISMISS is the transparent layer declared just before the list. It fills the page
             while the list is showing, and the list is a LATER sibling, so the list draws (and therefore
             hit-tests) ABOVE the layer: a press that lands on the layer is by construction a press OUTSIDE the
             list, whatever it looks like underneath — the header, a section, the footer buttons. Closing is
             one-way (there is no toggle here), so this click can only hide; the bell is still the only control
             that opens it. The layer is visible only while the list is, so with the list away every click
             reaches the app as before. This is the same idiom as Backdrop above, kept in-window for the reasons
             this comment lists for the list itself. -->
        <Border x:Name="NotificationDismissLayer" Background="Transparent"
                IsVisible="{Binding IsNotificationsOpen}"/>
        <Border x:Name="NotificationPanel" Classes="notifyPane"
                Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,44,14,0"
                IsVisible="{Binding IsNotificationsOpen}"
                BoxShadow="0 4 16 0 #55000000">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Margin="2,0,0,0" Text="{l:Tr Notifications}"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Notifications.IsEmpty}"
                       Text="{l:Tr 'No notifications.'}"/>
            <ScrollViewer MaxHeight="260"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Notifications.Items}">
                <ItemsControl.ItemTemplate>
                  <!-- One entry. The two controls are the owner's two verbs: the message itself is the button,
                       and the ✕ beside it IGNORES it, which takes it off the list for good. What the message's
                       click does depends on the entry: a plain one (the retry-install) RUNS its action, while one
                       with a body (the update notice) EXPANDS to show that body — its changelog and the explicit
                       Install button — and installs nothing until that button is pressed. An unread entry is
                       marked twice over — the dot and the weight — because a 6px dot alone is a thin clue for the
                       one thing the badge is counting. -->
                  <DataTemplate x:DataType="vm:NotificationViewModel">
                    <!-- One entry IS one card. The message and its ✕ are the card header (the ✕ is inside
                         the same surface, not a chip floating beside it), and the expanded changelog/Install
                         body is that same surface continued below a hairline — no second box, no seam. -->
                    <Border Classes="noticeCard">
                      <StackPanel>
                        <Grid ColumnDefinitions="10,*,Auto" Margin="8,6,6,6">
                          <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Unread}" Fill="{DynamicResource AccentBrush}"/>
                          <Button Grid.Column="1" Classes="notice" Classes.unread="{Binding Unread}"
                                  Command="{Binding ActivateCommand}">
                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Text}"/>
                          </Button>
                          <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="2,0,0,0"
                                  Command="{Binding DismissCommand}" ToolTip.Tip="{l:Tr Ignore}">
                            <!-- An ✕, drawn: the same convention as the bell and the drawer's back arrow. -->
                            <Path Width="8" Height="8" Stretch="None"
                                  Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" StrokeLineCap="Round"
                                  Data="M0.8,0.8 L7.2,7.2 M7.2,0.8 L0.8,7.2"/>
                          </Button>
                        </Grid>
                        <!-- The expanded body, attached to the header's card. Only an entry that carries one
                             (HasDetails) can reach IsExpanded, so the hardware-access offers never grow this
                             panel; Install is the only install trigger on the whole surface. -->
                        <Border Classes="noticeDetails" IsVisible="{Binding IsExpanded}">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontWeight="SemiBold" IsVisible="{Binding HasChangelog}"
                                       Text="{l:Tr Changelog}"/>
                            <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasChangelog}">
                              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Details}"/>
                            </ScrollViewer>
                            <Button Classes="accent" HorizontalAlignment="Right" Padding="14,5"
                                    Content="{l:Tr Install}" Command="{Binding InstallCommand}"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== Options / Lighting page (pushed over Home) ===== -->
      <Grid x:Name="DrawerPage" Classes.open="{Binding IsDrawerOpen}">
        <Grid.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseInOut"/>
          </Transitions>
        </Grid.Transitions>
        <DockPanel Margin="14">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <!-- Back points toward Home (to the left); vector so it's centred. -->
            <Button x:Name="BackButton" Classes="icon" Command="{Binding CloseDrawerCommand}">
              <Path Width="11" Height="10" Stretch="None"
                    Stroke="{DynamicResource AppMuted}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M10,5 H1 M4.5,1.5 L1,5 L4.5,8.5"/>
            </Button>
            <TextBlock Grid.Column="1" Classes="h1" VerticalAlignment="Center" Margin="6,0,0,0"
                       Text="{Binding DrawerTitle}"/>
          </Grid>
          <!-- One host PER PAGE, switched by visibility — deliberately NOT a single ContentControl bound to
               DrawerContent. Swapping three heterogeneous view-models through one presenter left it empty:
               after the Tuning page (the only one with nested ContentControls of its own) had been hosted,
               the presenter built no view at all for the next page. Separate hosts mean each view is created
               once and never re-hosted; a collapsed one isn't measured, so the flyout still sizes to the page
               on screen. See MainViewModel's page flags. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel>
              <ContentControl Content="{Binding OptionsPage}"  IsVisible="{Binding IsOptionsPage}"/>
              <ContentControl Content="{Binding LightingPage}" IsVisible="{Binding IsLightingPage}"/>
              <ContentControl Content="{Binding TuningPage}"   IsVisible="{Binding IsTuningPage}"/>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Grid>

    </Panel>
  </Border>
  </Panel>
</Window>
