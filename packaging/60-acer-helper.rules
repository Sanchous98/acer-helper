# AcerHelper — grant the "wheel" group write access to the laptop-control sysfs knobs, so the app runs
# UNPRIVILEGED (it never needs to be launched as root). These knobs are root-only by default; the app hides
# any control it can't actually operate, so without this file the Dell/generic firmware controls stay hidden.
#
# Install: packaging/install-permissions.sh (or copy to /etc/udev/rules.d/ and
#          `udevadm control --reload && udevadm trigger`). Members of "wheel" can already sudo, so granting
#          them these specific writes adds no meaningful privilege. Edit "wheel" to another group if desired.
#
# udev sets MODE/GROUP on device NODES, not on the sysfs ATTRIBUTE files we need, so we chgrp+chmod the
# specific attributes via RUN (the pattern TLP and the battery-health tools use). %p is the device's devpath.
# NB: a literal "$" in a RUN value must be written "$$" — a bare "$f" is an unknown substitution and udev
# rejects the whole rule ("invalid substitution type"; udevadm verify catches it).

# Battery charge mode + custom charge thresholds (power_supply; Dell dell-laptop / dell-wmi-ddv, kernel 6.12+)
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT[0-9]", \
  RUN+="/bin/sh -c 'for f in charge_types charge_control_start_threshold charge_control_end_threshold; do chgrp wheel /sys%p/$$f 2>/dev/null && chmod g+w /sys%p/$$f 2>/dev/null; done'"

# Keyboard backlight (kernel LED class): brightness + auto-off timeout
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*kbd_backlight", \
  RUN+="/bin/sh -c 'for f in brightness stop_timeout; do chgrp wheel /sys%p/$$f 2>/dev/null && chmod g+w /sys%p/$$f 2>/dev/null; done'"

# Performance/thermal profile (kernel platform-profile class, 6.14+). Also fix the legacy ACPI alias here:
# it appears only when the first handler registers, and EC modules often load after the boot tmpfiles pass,
# so the tmpfiles.d companion misses it (kept there for pre-6.14 kernels, where there is no class event).
ACTION=="add|change", SUBSYSTEM=="platform-profile", \
  RUN+="/bin/sh -c 'chgrp wheel /sys%p/profile 2>/dev/null && chmod g+w /sys%p/profile 2>/dev/null; chgrp wheel /sys/firmware/acpi/platform_profile 2>/dev/null && chmod g+w /sys/firmware/acpi/platform_profile 2>/dev/null'"

# Acer fan PWM attributes (the acer-wmi driver's own hwmon chip). This needs a rule of its own rather than
# riding any rule above, and the reason is the shape of the thing: the chip is a hwmon CLASS DEVICE whose
# pwm* entries are sysfs ATTRIBUTE FILES, not a device node — udev's MODE/GROUP only ever reach nodes, so
# without the RUN below the files stay 0644 root:root and fan write is impossible even when the driver exposes
# it (nothing else in this file, nor tmpfiles.d, grants hwmon access). The chip appears on MODULE LOAD, often
# well after boot, so udev rather than tmpfiles; "add" is the event it gets when acer_wmi loads, and "change"
# lets `udevadm trigger --subsystem-match=hwmon` apply this live on install.
#
# Matched on DEVPATH (the chip's place under the acer-wmi platform device; `*` also spans "/" here, as in
# systemd's own 78-sound-card.rules) and NOT on the chip's "name" attribute: "name" is read-only, so it can
# never be written to and ATTR{} on it cannot be used for this either. The file names are GLOBBED, not named:
# the channel count and the exact names depend on the driver build — the measured set on this machine (with the
# parameters this repo installs) is pwm1, pwm1_enable, pwm2 and pwm2_enable, the duty living in pwmN and there
# being no pwmN_input — so the one glob covers whichever of pwmN / pwmN_enable / pwmN_input a build exposes,
# and naming them one by one would silently miss the rest.
ACTION=="add|change", SUBSYSTEM=="hwmon", DEVPATH=="*/acer-wmi/hwmon/hwmon*", \
  RUN+="/bin/sh -c 'for f in /sys%p/pwm*; do chgrp wheel $$f 2>/dev/null && chmod g+w $$f 2>/dev/null; done'"

# Acer HID interfaces: the ENE RGB controller (keyboard + lightbar) and the EC controller that carries the
# performance envelope. Both are plain HID devices the app opens READ-WRITE — on recent models on HID-over-I2C
# (USB on older ones) — so match the kernel NAME of the parent hid device rather than idVendor: an I2C-HID
# device has no USB vendor attribute anywhere in its parent chain, and a USB-shaped rule silently never
# matches. KERNELS walks the parent chain, and only the bus prefix differs between the two buses
# (0018:… vs 0003:…), so one glob covers both.
#
# This rule is REQUIRED, not a convenience. systemd's own 70-uaccess.rules grants "uaccess" to hidraw only for
# a few hwdb-classified device classes (AV production controllers, AV lights, hardware wallets, 3D mice); there
# is no blanket rule and upstream declined one (systemd#38991), so without this the nodes open EACCES and both
# controllers silently report "not present" — RGB and the power-envelope channel just disappear.
SUBSYSTEM=="hidraw", KERNELS=="*:0CF2:5130.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*:1025:174B.*", TAG+="uaccess"

# Nitro key (the NitroSense launcher key): atkbd delivers it on the AT keyboard as KEY_PRESENTATION, and
# the app reads it from evdev. /dev/input/event* is root:input, so tag the keyboard with "uaccess" — an
# ACL for the ACTIVE local session only (tighter than the input group: no background/remote sessions).
# Note this lets session apps read this keyboard's events; scoped to Acer machines via DMI.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="AT Translated Set 2 keyboard", \
  ATTR{[dmi/id]sys_vendor}=="Acer*", TAG+="uaccess"

# AMD Curve Optimizer (CPU undervolt): the SMU mailbox nodes the ryzen_smu driver exposes. The app reaches the
# mailbox through "smn" (the driver's command nodes cannot report a refusal — see docs/curve-optimizer-linux.md);
# the other three writable attributes are granted with it because they are the driver's whole writable surface,
# and a half-granted driver is a worse outcome than a whole one for the other tools that share it.
#
# IT IS MATCHED ON THE PCI DEVICE'S BIND EVENT, and that is forced by the shape of what is being granted. The
# driver's own sysfs tree (/sys/kernel/ryzen_smu_drv) is a BARE KOBJECT: it is not a device, it registers no
# uevent, and udev's MODE/GROUP — which only ever reach device NODES — cannot touch its attribute files at all.
# What DOES emit an event is the PCI device the driver binds to (00:00.0, the host bridge whose config space
# carries the SMU mailbox), so the rule hangs off that and reaches the attribute files by absolute path in RUN
# rather than through %p. The paths therefore must not be rewritten as a substitution: %p there is the PCI
# device's directory, not the driver's kobject.
#
# ACTION=="bind" is the event that carries the driver name, and it fires on module load and on a reload — which is
# exactly "the nodes have just been (re)created with root-only permissions". It does NOT fire for an already-bound
# driver, which is the state a user is in when they grant access from the running app, and on a machine whose
# ryzen_smu is inserted from the INITRAMFS it does not reach this rule at all (see the two paragraphs below).
# "add|change" would not replace it — a bind is a different uevent, and `udevadm trigger` replays change events,
# not bind ones.
#
# THE RUN WAITS FOR THE FILES, because the bind event does not promise they exist yet: the driver's attribute
# files are created by a different step of the module's load than the one that emits the bind, and when the event
# reaches this rule first, every group change below fails into 2>/dev/null — silently, which is how a rule that
# looks installed can grant nothing. The loop polls /sys/kernel/ryzen_smu_drv/smn (the one node the app gates on) for up
# to ~5 s in 0.1 s steps and then grants whether or not it arrived: a bounded wait cannot hang udev for long, and
# the cold case still ends the same way it used to.
#
# THIS RULE IS NOT THE BOOT GRANT, and treating it as one is the measured failure this file was just corrected
# for. It only ever runs where udev sees a bind — and on this machine ryzen_smu is inserted from the initramfs
# (journal: "systemd-modules-load[335]: Inserted module 'ryzen_smu'" during dracut's run), so the bind uevent is
# emitted before the real systemd-udevd exists, and systemd-udev-trigger's coldplug replays add/change, never a
# bind. The deterministic every-boot grant is packaging/acer-helper-smu-perms.service; this rule is what covers a
# MANUAL module reload, where udev is already up and the files appear at once.
ACTION=="bind", SUBSYSTEM=="pci", DRIVER=="ryzen_smu", \
  RUN+="/bin/sh -c 'i=0; while [ ! -e /sys/kernel/ryzen_smu_drv/smn ] && [ $$i -lt 50 ]; do sleep 0.1; i=$$((i+1)); done; for f in smu_args mp1_smu_cmd rsmu_cmd smn; do chgrp wheel /sys/kernel/ryzen_smu_drv/$$f 2>/dev/null && chmod g+w /sys/kernel/ryzen_smu_drv/$$f 2>/dev/null; done'"
