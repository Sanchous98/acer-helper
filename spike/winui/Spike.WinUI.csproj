<Project Sdk="Microsoft.NET.Sdk">

  <!-- THROWAWAY SPIKE. Its only job is to answer, with a real build, whether WinUI 3 + Native AOT is a viable
       front-end for this app on Windows. It deliberately does NOT reference AcerHelper.csproj: the core
       (Domain/Application/Infrastructure) is already toolkit-agnostic, so the risk being measured here is the
       UI stack, not the core reuse. Nothing else in the repo builds this file. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Spike.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The two make-or-break knobs for our shipping model: no MSIX, and Native AOT. -->
    <PublishAot>true</PublishAot>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- The tray. Note the version: H.NotifyIcon has no stable WinUI release — only beta/dev. That is itself a
         finding for the evaluation (the real app would either pin a beta or hand-roll Shell_NotifyIcon). -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
  </ItemGroup>

  <!-- WindowsAppSDK#6394. With PublishAot=true and WindowsPackageType=None the compiler drops the app's compiled
       XAML resources (.xbf) and the package resource index (.pri) from the PUBLISH folder, so the published exe
       dies at startup with STATUS_STOWED_EXCEPTION (0xC000027B) inside Microsoft.UI.Xaml.dll — exactly the crash
       this spike hit. The workaround the issue documents is to copy them out of the build output after Publish. -->
  <Target Name="CopyXamlResourcesForAot" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_XamlResources Include="$(OutputPath)**\*.xbf" />
      <_XamlResources Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlResources)"
          DestinationFiles="@(_XamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
