<?xml version="1.0" encoding="UTF-8"?>
<!-- THROWAWAY: a minimal per-machine MSI over the spike's AOT output, so the CI run can report a SHIPPING-SIZE
     number comparable to the app's own WiX MSI (packaging/AcerHelper.wxs). It is deliberately not the app's
     installer: same shape (Program Files\Folder, Compressed, MajorUpgrade, embedded cab), different payload. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Spike WinUI"
           Manufacturer="spike"
           Version="1.0.0"
           UpgradeCode="a1b2c3d4-1111-2222-3333-444455556666"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Spike WinUI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="Spike WinUI">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SpikeWinUI" />
    </StandardDirectory>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

  </Package>
</Wix>
