<Window
    x:Class="Spike.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#33FFFFFF"
            Background="#26000000" Padding="16">
        <StackPanel Spacing="8">
            <TextBlock Text="Acer Helper — flyout spike" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Borderless · acrylic · always-on-top · no taskbar · hide on blur" Opacity="0.8"/>
            <TextBlock Text="Move focus away: this window should hide." Opacity="0.6" FontSize="12"/>
        </StackPanel>
    </Border>
</Window>
