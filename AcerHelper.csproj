<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>AcerHelper</AssemblyName>
    <RootNamespace>AcerHelper</RootNamespace>
    <Product>Acer Helper</Product>
    <Version>0.35.0</Version>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The Windows WMI layer talks to the WMI COM API directly via source-generated COM interop
         ([GeneratedComInterface]) and raw VARIANT/SAFEARRAY pointers — needs unsafe. This is what makes
         WMI Native-AOT-safe: System.Management uses classic (runtime-IL-stub) COM interop, which AOT
         does not support. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- RID/self-contained are passed per publish so each TFM×OS resolves correctly:
         win-x64 (Native AOT) and linux-x64 (self-contained single-file). -->
  </PropertyGroup>

  <!-- Windows backend: full Acer/Windows (WinExe + COM interop + elevation manifest). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Portable (Linux) build: no Windows subsystem, no manifest, no System.Management. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- OS-specific implementations are selected by file-name suffix (*.Windows.cs / *.Linux.cs):
       each OS keeps only its own files, so Win32 P/Invoke and System.Management stay entirely out
       of the portable (net10.0) compile. No preprocessor directives.
       NOTE: the portable TFM is "net10.0" (it does NOT contain "linux"), so the non-Windows case
       is expressed as "not windows". -->
  <ItemGroup>
    <!-- Исключаем файлы Linux при сборке под Windows -->
    <Compile Remove="**/*.Linux.cs" Condition="$(TargetFramework.Contains('windows'))" />
    <!-- Исключаем файлы Windows во всех остальных (портируемых) сборках -->
    <Compile Remove="**/*.Windows.cs" Condition="!$(TargetFramework.Contains('windows'))" />
  </ItemGroup>

  <!-- The Linux installer's input, carried INTO the build output. HardwareAccess reads these from
       AppContext.BaseDirectory and installs them into /etc for the AppImage case, so a publish that does not
       carry them is a publish whose "Grant hardware access" offer silently never appears (RulesNeeded() finds
       nothing to compare and returns false) — the whole access feature disappears with no error anywhere. That
       is why this is an ItemGroup with a reason rather than the flat "copy packaging/* in the AppImage step"
       that used to be the only path: the Dockerfile's publish, a local publish and any future RPM all get the
       files from here.
       The Link= is the BARE file name on purpose: the four land side by side in one flat folder next to the
       binary (that is what HardwareAccess looks for), so the packaging/ prefix must not survive the copy.
       GATED ON !windows: the Windows publish feeds the WiX MSI, which harvests publish\** wholesale — udev,
       tmpfiles.d, systemd and modprobe.d files have no business inside an MSI, and a Linux-only feature's inputs must
       not become Windows install payload. (Same "not windows" spelling as the Compile filter above: the
       portable TFM is "net10.0" and does NOT contain "linux".) -->
  <ItemGroup Condition="!$(TargetFramework.Contains('windows'))">
    <Content Include="packaging\60-acer-helper.rules" Link="60-acer-helper.rules"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="packaging\acer-helper.conf" Link="acer-helper.conf"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="packaging\acer-helper-smu-perms.service" Link="acer-helper-smu-perms.service"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="packaging\acer-helper-modprobe.conf" Link="acer-helper-modprobe.conf"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The tests live in their own project under tests/, but the SDK's implicit **/*.cs glob would otherwise
       compile every test source INTO the shipped app (and its Avalonia/Native-AOT closure). Excluded here so
       the test tree is invisible to both TFMs of this project. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- The silent-failure targets are private by design (they are internal encodings, not API), so the test
       assembly is granted access rather than each helper being widened to public. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AcerHelper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Per-model Acer quirks DB (friendly name + RGB layout); loaded at runtime, user-overridable. -->
  <ItemGroup>
    <EmbeddedResource Include="acer-models.json" />
  </ItemGroup>

  <!-- PawnIO's RyzenSMU module (LGPL-2.1-or-later, © namazso) — the bytecode the CPU undervolt loads into the
       driver. Its author prescribes bundling it ("include its contents in your software") precisely because module
       APIs carry NO stability guarantee across releases, so the exact bytes this code was verified against travel
       with the build; provenance, licence and the update procedure are in third-party/README.md. Conditional only so
       a checkout that deliberately drops the blob still compiles — the undervolt section then hides itself. -->
  <ItemGroup Condition="Exists('third-party\RyzenSMU.bin') And $(TargetFramework.Contains('windows'))">
    <EmbeddedResource Include="third-party\RyzenSMU.bin" />
  </ItemGroup>

  <!-- Default packaging: one compressed, self-extracting single-file .exe (JIT).
       Mutually exclusive with Native AOT, so disabled when PublishAot=true. -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- HidSharp (the Windows RGB HID transport) reflects internally and isn't trim-annotated (warning
       IL2104 under AOT). Root the whole assembly when AOT-publishing so trimming can't strip its Win32
       HID backend and silently break RGB. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(TargetFramework)' == 'net10.0-windows'">
    <TrimmerRootAssembly Include="HidSharp" />
  </ItemGroup>

  <!-- Cross-platform packages.
       NOTE: do NOT pin Tmds.DBus.Protocol explicitly. It is Avalonia's Linux D-Bus transport
       (tray/StatusNotifierItem, X11 IME), and Avalonia.Desktop must control its version — an
       independent pin (e.g. 0.94.2) loads a Tmds where Avalonia's expected types moved, crashing
       at X11 init with "Could not load type 'Tmds.DBus.Protocol.Connection'". Let it flow transitively.

       X11 REMAINS THE LINUX TARGET: no Wayland backend is referenced, and Bootstrap/Program.cs calls
       plain UsePlatformDetect(). A short Wayland trial was run and abandoned — its findings, kept so
       the question does not get re-opened from scratch:
         * the compositor, not the client, decides where a toplevel goes, so the corner-anchored flyout
           cannot position itself under Wayland the way it does under X11;
         * Avalonia offers no layer-shell surface, so the panel-style alternative is not available
           either — those two together are disqualifying, not a matter of polish;
         * Avalonia.Desktop holds no Wayland strings at all, so UsePlatformDetect() can never select a
           Wayland backend on its own; one has to be named explicitly.
       What the trial left behind is the version bump only: the Wayland backend has no release below
       12.1.0, so the four pins below sit on 12.1.x rather than 12.0.5. They stay there deliberately —
       that line is the current stable one and the owner keeps it ("раз уж avalonia обновился"). -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <!-- MVVM: source-generated (AOT/trim-safe) ObservableObject/[ObservableProperty]/[RelayCommand]. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Windows-only platform packages. WMI is accessed via source-generated COM interop to the WMI COM
       API directly (see Infrastructure/Vendors/Generic/WbemInterop.Windows.cs) — NOT System.Management, which
       is not Native-AOT-safe.
       HidSharp only serves the Windows RGB transport — Linux talks to hidraw directly
       (EneHidController.Linux.cs), because HidSharp's Linux enumeration misses HID-over-I2C devices. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <!-- Bake <Version> into a compile-time string constant (AcerHelper.Domain.AppInfo.Version) that the in-app update
       check reads. We must NOT get the running version from Assembly.GetName().Version: Native AOT (the
       shipped build) strips assembly-version reflection metadata and hands back 0.0.0.0, so every GitHub
       release looked newer than the running build and the app perpetually offered an "update" to the version
       already installed. A const is plain IL (a literal inlined at each use site) — immune to AOT/trim/
       single-file stripping — so this keeps the csproj <Version> as the single source of truth while working
       identically under JIT and AOT. Runs per-TFM (each writes into its own obj/<tfm> intermediate). -->
  <Target Name="GenerateAppVersion" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_AppVersionFile>$(IntermediateOutputPath)AppVersion.g.cs</_AppVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <_AppVersionLine Include="// &lt;auto-generated /&gt; Generated from &lt;Version&gt; in AcerHelper.csproj. Do not edit." />
      <_AppVersionLine Include="namespace AcerHelper.Domain%3B" />
      <_AppVersionLine Include="internal static class AppInfo" />
      <_AppVersionLine Include="{" />
      <_AppVersionLine Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <_AppVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_AppVersionFile)" Lines="@(_AppVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_AppVersionFile)" />
      <FileWrites Include="$(_AppVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
