<Project Sdk="Microsoft.NET.Sdk">

  <!-- An AOT probe that verifies THE APP'S OWN localisation resolves under Native AOT.

       WHY. The app historically compiled its translations into an in-memory table because Native AOT was
       believed not to load .resx satellites (dotnet/runtime#86651) — and a satellite that silently fails to
       load ships English. That belief was re-measured, not trusted: this project uses the REAL
       Localization/Loc.cs and the REAL Localization/Strings.ru.resx, is published Native AOT (the shipping
       configuration) by .github/workflows/build.yml, and is RUN; it fails the build if the Russian string does
       not come back. Testing the actual files (not a toy copy) is the point — a toy proves the mechanism, only
       this proves the migration.

       IT MUST STAY DEPENDENCY-FREE. Loc.cs pulls in nothing but System.Globalization/System.Resources, so it
       is linked in directly; there is no Avalonia here. RootNamespace = AcerHelper makes the linked resx embed
       under the SAME resource base name Loc.cs hardcodes ("AcerHelper.Localization.Strings"). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcerHelper</RootNamespace>
    <AssemblyName>LocalizationAotProbe</AssemblyName>
    <!-- Culture-sensitive resource lookup REQUIRES real globalization; an AOT app that sets this true cannot
         resolve by culture at all and would fail this probe for the wrong reason. Stated, not defaulted. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- The app's real localisation core and its two resource files, used verbatim. Link= keeps the project
       layout that decides the embedded resource base name (AcerHelper.Localization.Strings) and the satellite
       (ru/<assembly>.resources.dll); the app's Strings.resx is empty by design and Strings.ru.resx holds the
       Russian rows, keyed by the English text. -->
  <ItemGroup>
    <Compile Include="..\..\Localization\Loc.cs" Link="Localization\Loc.cs" />
    <EmbeddedResource Include="..\..\Localization\Strings.resx" Link="Localization\Strings.resx" />
    <EmbeddedResource Include="..\..\Localization\Strings.ru.resx" Link="Localization\Strings.ru.resx" />
  </ItemGroup>

</Project>
