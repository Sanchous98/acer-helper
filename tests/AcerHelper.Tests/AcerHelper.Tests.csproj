<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must be net10.0-windows, not net10.0: the highest-value targets (the SMU offset encoders and the
         WMI VARIANT marshalling) live in *.Windows.cs files, which the app's <Compile Remove> keeps out of
         the portable TFM entirely. Tests would simply not see them under net10.0. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>AcerHelper.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AcerHelper.csproj" />
  </ItemGroup>

  <!-- THE PLUGIN'S PURE BACKEND, COMPILED INTO THE TEST ASSEMBLY (docs/vendor-plugins.md §6 "Keeping the suite
       green"). The plugin is a separate Native AOT shared library the test project must NOT reference, and its
       ah_* thunks cannot be called from managed code ([UnmanagedCallersOnly], §2.1) — so the only way to
       unit-test the manifest/match logic is to compile the PURE, hardware-free helpers into this assembly and
       drive them directly.
       ONLY THESE TWO FILES ARE INCLUDED, deliberately: AcerMatch.cs and AcerManifestBuilder.cs reference nothing
       but the host's own types (AcerModels, AcerProfiles, Domain, the internal PluginManifest/PluginJsonContext,
       reachable through the host's InternalsVisibleTo) and the plugin's own data records. Pulling the session or
       the thunk files in would drag WmiInvoker/HidSharp/unsafe and would re-declare host types (AcerProfiles,
       AcerFanPort, …) inside this assembly as CS0436 conflicts — the same reason those files are NOT here. -->
  <ItemGroup>
    <Compile Include="..\..\plugins\AcerHelper.Vendor.acer-nitro\AcerMatch.cs" Link="Plugin\AcerMatch.cs" />
    <Compile Include="..\..\plugins\AcerHelper.Vendor.acer-nitro\AcerManifestBuilder.cs" Link="Plugin\AcerManifestBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
